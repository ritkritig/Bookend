# ==============================================================================
# BOOKEND MICROSERVICES ENVIRONMENT CONFIGURATION
# ==============================================================================

# RabbitMQ Event Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=bookend.events

# Service Dedicated Ports
GATEWAY_PORT=4000
IDENTITY_PORT=4001
CATALOG_PORT=4002
SOCIAL_PORT=4003
RECOMMENDATION_PORT=4004
ENGAGEMENT_PORT=4005

NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Service URLs (for Gateway and Inter-Service Sync REST)
IDENTITY_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
SOCIAL_SERVICE_URL=http://localhost:4003
RECOMMENDATION_SERVICE_URL=http://localhost:4004
ENGAGEMENT_SERVICE_URL=http://localhost:4005

# JWT Secrets
JWT_SECRET=bookend_super_secure_jwt_secret_editorial_2026_key
JWT_EXPIRES_IN=7d
